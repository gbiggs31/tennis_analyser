# TEMPLATE ONLY - THIS FILE IS TRACKED BY GIT.
#
# Do not put a real key here; it would be published on the next push.
# Put it in `.env` instead, which is gitignored:
#
#   cp .env.example .env      # then edit .env
#
# `tennis doctor` fails loudly if a real-looking key ends up in this file.
#
# Only needed for the labelling stage. Everything up to and including contact
# sheet generation runs entirely locally with no API access.

# From https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Where raw video and derived artifacts live. Keep this OUTSIDE the repo:
# the repo sits in a OneDrive-synced folder and a 120fps clip is multi-gigabyte.
# TENNIS_DATA_ROOT=C:\tennis_data
